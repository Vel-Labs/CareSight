{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareSightEvent",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "camera_id",
    "severity",
    "confidence",
    "status"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "possible_floor_stay",
        "medication_routine_likely_observed",
        "pet_food_activity_observed",
        "missed_routine",
        "camera_offline",
        "package_arrived"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "subject_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "camera_id": {
      "type": "string"
    },
    "zone_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "urgent"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_label": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "evidence": {
      "type": "object"
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    }
  }
}
