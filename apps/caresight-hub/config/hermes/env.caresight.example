# CareSight Hermes environment template.
# Do not put real secrets in this file.

OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=caresight-local

# Optional, human-approved BlueBubbles trial only.
CARESIGHT_CONTACT_ALLOWLIST_PATH=apps/caresight-hub/config/hermes/allowlisted-contacts.example.json
BLUEBUBBLES_SERVER_URL=
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_HOME_CHANNEL=
BLUEBUBBLES_HOME_CHANNEL_NAME=

# Keep hosted routing unset by default.
OPENROUTER_API_KEY=
