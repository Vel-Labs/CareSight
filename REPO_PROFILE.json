{
  "$schema": "./contracts/schemas/repo-profile.schema.json",
  "templateName": "CareSight Hub",
  "purpose": "Local-first CareSight hackathon project using scaffold governance plus a bounded Python/MLX runtime.",
  "rootPolicy": {
    "keepAtRoot": [
      ".claude/",
      ".github/",
      ".gitignore",
      ".gitmodules",
      "AGENTS.md",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "DECISIONS.md",
      "LICENSE",
      "NOTICE.md",
      "REPO_PROFILE.json",
      "README.md",
      "ROADMAP.md",
      "apps/",
      "contracts/",
      "docs/",
      "package.json",
      "package-lock.json",
      "packages/",
      "scripts/",
      "skills/",
      "template.vars.json",
      "tests/",
      "tsconfig.json",
      "vitest.config.ts"
    ],
    "rootDocsAllowed": [
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "DECISIONS.md",
      "LICENSE",
      "NOTICE.md",
      "ROADMAP.md"
    ],
    "note": "Root stays limited to entrypoints, conventional project files, and major implementation/doc directories."
  },
  "canonicalPaths": {
    "contracts": "contracts/",
    "core": "packages/core/",
    "runtime": "apps/caresight-hub/",
    "tests": "tests/",
    "docs": "docs/",
    "architecture": "docs/architecture/ARCHITECTURE.md",
    "repoBoundaries": "docs/architecture/REPO_BOUNDARIES.md",
    "roadmapIndex": "ROADMAP.md",
    "decisionsIndex": "DECISIONS.md",
    "currentState": "docs/roadmaps/CURRENT_STATE_AND_NEXT.md",
    "hackathonRoadmap": "docs/hackathon/hackathon_roadmap.md",
    "futureRoadmap": "docs/roadmaps/future_roadmap.md",
    "decisionLogs": "docs/decisions/",
    "aiUsage": "docs/governance/AI_USAGE.md",
    "agentStart": "docs/agents/START_HERE.md",
    "templateUsage": "docs/project/TEMPLATE_USAGE.md",
    "skills": "skills/",
    "audits": "docs/audits/",
    "templates": "docs/templates/"
  },
  "commands": {
    "install": "npm run install:local",
    "initializeTemplate": "npm run init:template",
    "dryRunTemplateInitializer": "npm run init:template:dry-run",
    "validateScaffold": "npm run validate:scaffold",
    "validateContracts": "npm run validate:contracts",
    "focusedTests": "npm run test:focused",
    "allTests": "npm test",
    "typecheck": "npm run typecheck",
    "pythonCheck": "npm run py:check",
    "fullCheck": "npm run check"
  },
  "readFirst": [
    "AGENTS.md",
    "REPO_PROFILE.json",
    "docs/agents/START_HERE.md",
    "docs/project/PROJECT_BRIEF.md",
    "contracts/README.md",
    "docs/architecture/ARCHITECTURE.md",
    "docs/architecture/REPO_BOUNDARIES.md",
    "packages/core/README.md",
    "apps/caresight-hub/README.md",
    "tests/README.md",
    "ROADMAP.md",
    "DECISIONS.md",
    "docs/roadmaps/CURRENT_STATE_AND_NEXT.md"
  ],
  "governanceLocked": [
    "AGENTS.md",
    "docs/architecture/ARCHITECTURE.md",
    "docs/architecture/REPO_BOUNDARIES.md",
    "docs/governance/",
    "docs/repo-truth/",
    "REPO_PROFILE.json"
  ],
  "downstreamScopes": [
    "runtime adapters",
    "camera integrations",
    "dashboard surfaces",
    "alert integrations",
    "provider integrations",
    "deployment workflows"
  ],
  "forbiddenRootDirectoriesBeforeProjectAdoption": [
    "adapters",
    "demos",
    "providers",
    "runtime-adapters"
  ],
  "allowedTemplatePlaceholders": [
    "CareSight Hub",
    "provide a reusable governance scaffold for future projects",
    "Contract-first scaffolding reduces hidden trust for humans and agents.",
    "template governance, contracts, core enforcement, local tests, and audit routing",
    "<IDENTITY_INTEGRATION>",
    "<DATA_OR_COMPUTE_INTEGRATION>",
    "<EXECUTION_INTEGRATION>",
    "<TOOL>",
    "<PURPOSE>",
    "<OWNER>",
    "<REVIEWER>",
    "<ONE_OR_TWO_SENTENCES>",
    "<PARTNER_1>",
    "<PARTNER_2>",
    "<PARTNER_3>",
    "<PROOF_1>",
    "<PROOF_2>",
    "<PROOF_3>",
    "<THE_ONE_SENTENCE_DEMO_CLOSE>",
    "<SUBMISSION_DEADLINE>",
    "<VIDEO_LENGTH_REQUIREMENT>",
    "<PARTNER_SELECTION_RULE>",
    "<HOW_THE_PROJECT_QUALIFIES>",
    "<EVIDENCE_1>",
    "<EVIDENCE_2>",
    "<FILE_OR_FOLDER>",
    "<ONE_SENTENCE_DESCRIPTION>",
    "<WHAT_PROBLEM_ARE_WE_SOLVING>",
    "<WHAT_ARE_WE_BUILDING>",
    "<USER_1>",
    "<USER_2>",
    "<MVP_REQUIREMENT_1>",
    "<MVP_REQUIREMENT_2>",
    "<MVP_REQUIREMENT_3>",
    "<NON_GOAL_1>",
    "<NON_GOAL_2>",
    "<SUCCESS_CRITERION_1>",
    "<SUCCESS_CRITERION_2>",
    "<WHAT_THIS_FEATURE_CREATES>",
    "<GOAL_1>",
    "<GOAL_2>",
    "<Feature Or Phase>",
    "<path>",
    "<exact command>",
    "<command>",
    "<result>",
    "<absolute repo path>",
    "<specific objective>",
    "<task-specific docs>"
  ],
  "qualityGate": [
    "npm run validate:scaffold",
    "npm run validate:contracts",
    "npm run test:focused",
    "npm test",
    "npm run typecheck",
    "npm run py:check"
  ]
}
