{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-governance-scaffold.local/schemas/media-sharing-policy.schema.json",
  "title": "MediaSharingPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "media_type",
    "scope",
    "approval_state",
    "approved_by",
    "approved_at",
    "redaction_required",
    "redaction_status",
    "retention_class",
    "blocked_media_types",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "media-sharing-policy"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^media_policy_[a-z0-9_-]+$"
    },
    "media_type": {
      "type": "string",
      "enum": ["event_scoped_snapshot", "event_scoped_text_excerpt", "raw_video"]
    },
    "scope": {
      "type": "string",
      "enum": ["event_scoped", "raw_feed", "unbounded"]
    },
    "approval_state": {
      "type": "string",
      "enum": ["approved", "blocked", "not_requested"]
    },
    "approved_by": {
      "type": ["string", "null"],
      "minLength": 2
    },
    "approved_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "redaction_required": {
      "type": "boolean"
    },
    "redaction_status": {
      "type": "string",
      "enum": ["not_required", "pending", "completed", "blocked"]
    },
    "retention_class": {
      "type": "string",
      "enum": ["ephemeral_handoff", "local_event_record", "do_not_export"]
    },
    "blocked_media_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["raw_video", "continuous_feed", "unredacted_private_text"]
      },
      "contains": {
        "const": "raw_video"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "source", "source_fields"],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^evt_[a-z0-9_-]+$"
        },
        "source": {
          "type": "string",
          "enum": ["sqlite_event_review", "operator_media_approval"]
        },
        "source_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_state": {
            "const": "approved"
          }
        },
        "required": ["approval_state"]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string",
            "minLength": 2
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "scope": {
            "const": "event_scoped"
          },
          "media_type": {
            "enum": ["event_scoped_snapshot", "event_scoped_text_excerpt"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "redaction_required": {
            "const": true
          }
        },
        "required": ["redaction_required"]
      },
      "then": {
        "properties": {
          "redaction_status": {
            "const": "completed"
          }
        }
      }
    }
  ]
}
