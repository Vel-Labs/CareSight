{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-governance-scaffold.local/schemas/agent-draft.schema.json",
  "title": "AgentDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "draft_id",
    "event_id",
    "created_at",
    "provider",
    "source_of_truth",
    "purpose",
    "validation_status",
    "draft_text",
    "safety_boundaries",
    "provenance",
    "blocked_claims"
  ],
  "properties": {
    "schema": {
      "const": "agent-draft"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^draft_[a-z0-9_-]+$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[a-z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "string",
      "enum": ["fake", "gemma_mlx"]
    },
    "source_of_truth": {
      "const": "sqlite"
    },
    "purpose": {
      "type": "string",
      "enum": ["caregiver_summary", "alert_draft", "apple_notes_entry", "handoff_packet", "audit_summary"]
    },
    "validation_status": {
      "type": "string",
      "enum": ["validated", "blocked"]
    },
    "draft_text": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1200
    },
    "safe_rewrite": {
      "type": ["string", "null"],
      "minLength": 3,
      "maxLength": 1200
    },
    "safety_boundaries": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "draft_only",
          "human_review_required",
          "sqlite_canonical",
          "no_autonomous_dispatch",
          "no_medical_diagnosis",
          "no_medication_confirmation",
          "no_hipaa_claim"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "draft_only"
          }
        },
        {
          "contains": {
            "const": "human_review_required"
          }
        },
        {
          "contains": {
            "const": "sqlite_canonical"
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_fields"],
      "properties": {
        "source": {
          "const": "sqlite_audit_chain"
        },
        "source_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "blocked_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "medical_device",
          "hipaa_compliance",
          "autonomous_emergency_dispatch",
          "medication_administration",
          "vision_overcertainty"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validation_status": {
            "const": "validated"
          }
        },
        "required": ["validation_status"]
      },
      "then": {
        "properties": {
          "blocked_claims": {
            "type": "array",
            "maxItems": 0
          },
          "draft_text": {
            "not": {
              "type": "string",
              "pattern": "([Mm]edical device|[Hh][Ii][Pp][Aa][Aa] compliant|[Dd]ispatch(ed)? emergency|[Cc]alled 911|[Mm]edication was taken|[Cc]onfirmed medication|[Ff]all detected|[Dd]iagnosed)"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation_status": {
            "const": "blocked"
          }
        },
        "required": ["validation_status"]
      },
      "then": {
        "required": ["safe_rewrite"],
        "properties": {
          "blocked_claims": {
            "type": "array",
            "minItems": 1
          },
          "safe_rewrite": {
            "type": "string"
          }
        }
      }
    }
  ]
}
