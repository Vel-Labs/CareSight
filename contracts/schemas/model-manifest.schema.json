{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-governance-scaffold.local/schemas/model-manifest.schema.json",
  "title": "ModelManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_id",
    "purpose_lane",
    "source_url",
    "license",
    "local_path",
    "sha256",
    "expected_size_bytes",
    "runtime",
    "allowed_uses",
    "blocked_uses",
    "validation_command",
    "last_validated_at"
  ],
  "properties": {
    "schema": { "const": "model-manifest" },
    "model_id": { "type": "string", "pattern": "^model_[a-z0-9_-]+$" },
    "purpose_lane": { "type": "string", "enum": ["vision", "reasoning", "tts", "privacy_filter"] },
    "source_url": { "type": "string", "format": "uri" },
    "license": { "type": "string", "minLength": 2 },
    "local_path": { "type": "string", "minLength": 2 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expected_size_bytes": { "type": "integer", "minimum": 1 },
    "runtime": { "type": "string", "enum": ["yolo26_mlx", "mlx_vlm", "holler", "transformers", "local_python"] },
    "allowed_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "blocked_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["medical_diagnosis", "autonomous_emergency_dispatch", "medication_administration_confirmation", "biometric_identity", "hipaa_compliance_claim", "raw_video_cloud_upload", "safety_guarantee"]
      }
    },
    "validation_command": { "type": "string", "minLength": 2 },
    "last_validated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
